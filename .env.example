KD_ENVIRONMENT=local
KD_MODE=search
KD_DB_PASSWORD=replace-with-a-local-random-bootstrap-password
KD_APP_PASSWORD=replace-with-a-local-random-application-password
KD_SECRET_KEY=replace-with-at-least-32-random-characters
KD_SECURE_COOKIES=false
KD_OLLAMA_URL=http://host.docker.internal:11434
KD_EMBEDDING_MODEL=qwen3-embedding:0.6b
KD_GENERATION_MODEL=qwen2.5:1.5b-instruct-q4_K_M
KD_EMBEDDING_DIMENSIONS=1024
KD_GENERATION_CONTEXT_TOKENS=4096
KD_GENERATION_MAX_TOKENS=512
KD_GENERATION_TIMEOUT_SECONDS=300
KD_QUESTION_RATE_LIMIT_PER_MINUTE=20
